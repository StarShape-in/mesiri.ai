  "shadows": {
    "sm": {
      "shadowColor": "#000000",
      "shadowOffset": { "width": 0, "height": 1 },
      "shadowOpacity": 0.06,
      "shadowRadius": 3,
      "elevation": 2
    },
    "md": {
      "shadowColor": "#000000",
      "shadowOffset": { "width": 0, "height": 4 },
      "shadowOpacity": 0.08,
      "shadowRadius": 12,
      "elevation": 4
    },
    "lg": {
      "shadowColor": "#000000",
      "shadowOffset": { "width": 0, "height": 8 },
      "shadowOpacity": 0.12,
      "shadowRadius": 24,
      "elevation": 8
    },
    "primary": {
      "shadowColor": "#E8450F",
      "shadowOffset": { "width": 0, "height": 4 },
      "shadowOpacity": 0.35,
      "shadowRadius": 12,
      "elevation": 6
    },
    "nav": {
      "shadowColor": "#1C1C2E",
      "shadowOffset": { "width": 0, "height": 8 },
      "shadowOpacity": 0.45,
      "shadowRadius": 24,
      "elevation": 12
    }
  },
  "animation": {
    "duration": {
      "instant": 0,
      "micro": 150,
      "fast": 200,
      "standard": 300,
      "slow": 400
    },
    "easing": {
      "default": "ease-out",
      "entry": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "inOut": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "spring": {
      "damping": 15,
      "stiffness": 150
    }
  },
  "opacity": {
    "disabled": 0.45,
    "pressedPrimary": 0.82,
    "pressedSecondary": 0.75,
    "pressedNav": 0.70,
    "pressedFab": 0.85,
    "pressedCard": 0.80,
    "inactiveNav": 0.45,
    "modalBackdrop": 0.4
  },
  "breakpoints": {
    "sm": 375,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1440
  },
  "layout": {
    "screenHorizontalPadding": 16,
    "cardBorderWidth": 1,
    "cardBorderOpacity": 0.07,
    "inputBorderWidth": 2,
    "inputMinHeight": 48,
    "searchInputHeight": 44,
    "touchTargetMin": 44,
    "sidebarWidth": 240,
    "contentMaxWidth": 1200,
    "gridColumns": 12,
    "gridGutter": 24
  },
  "avatar": {
    "sizes": {
      "sm": { "diameter": 28, "fontSize": 10, "dotSize": 8 },
      "md": { "diameter": 36, "fontSize": 12, "dotSize": 10 },
      "lg": { "diameter": 48, "fontSize": 14, "dotSize": 12 },
      "xl": { "diameter": 64, "fontSize": 18, "dotSize": 14 }
    },
    "groupOverlap": -8,
    "overflowDiameter": 36,
    "dotBorderWidth": 2
  },
  "navigation": {
    "driver": {
      "pillPaddingHorizontal": 16,
      "pillPaddingVertical": 10,
      "wrapperPaddingHorizontal": 24,
