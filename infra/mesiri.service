[Unit]
Description=Mesiri.AI WhatsApp Assistant (FastAPI / uvicorn)
Documentation=https://github.com/your-org/Mesiri.AI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mesiri/apps/whatsapp-assistant/src

# All four Python source roots must be on PYTHONPATH.
Environment=PYTHONPATH=/opt/mesiri/shared/contracts/src:/opt/mesiri/platform/ai/src:/opt/mesiri/backend/src:/opt/mesiri/apps/whatsapp-assistant/src

# Runtime settings come from this file. Copy .env.example → .env and fill in
# production values. The file must NOT be committed to git.
EnvironmentFile=/opt/mesiri/.env

ExecStart=/opt/mesiri/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --log-level info

# Graceful reload on SIGHUP (used by systemctl reload).
ExecReload=/bin/kill -HUP $MAINPID

# Always restart on crash; wait 5 s before retrying.
Restart=on-failure
RestartSec=5s

# Route stdout/stderr to the system journal (view with: journalctl -u mesiri -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mesiri

[Install]
WantedBy=multi-user.target
