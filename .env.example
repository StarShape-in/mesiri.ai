# ─── MERCON monorepo env reference ───────────────────────────────
# Copy the relevant block into each app's own .env file.
# App-specific templates: backend/api-server/.env.example, frontend/web-dashboard/.env.example

# ── backend/api-server ──
DATABASE_URL=postgresql://user:password@localhost:5432/mercon
JWT_SECRET=change-me-in-production
PORT=4000

# ── docker-compose.yml (root) — required for `docker compose up`, both
#    locally and in CI/CD. In production these are set as GitHub Actions
#    secrets (Settings → Secrets → Actions), never committed here.
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
# One-time password for the seeded admin/operator accounts. Change this
# and rotate the account passwords after first login in any real deploy.
SEED_ADMIN_PASSWORD=change-me

# ── frontend/web-dashboard (Vite: must be prefixed VITE_) ──
VITE_API_URL=http://localhost:4000
